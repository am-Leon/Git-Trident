# =============================================================================
# FILE WRITING
# =============================================================================

# Write the appropriate files for the given environment.
# Staging:    CHANGELOG.md + QA_NOTES.md
# Production: CHANGELOG.md + RELEASE_NOTES.md
write_files() {
    local environment="$1"
    local output_dir="$2"
    local version_display="$3"
    local date_str="$4"
    local commits="$5"

    local is_prod_changelog=false
    [ "$environment" = "production" ] && is_prod_changelog=true

    # --- CHANGELOG.md (always, no exclusions) ---
    local changelog_categorized
    changelog_categorized=$(categorize_commits "$commits" "changelog")
    local changelog_section
    changelog_section=$(generate_version_section "$version_display" "$date_str" "$changelog_categorized" "$is_prod_changelog")
    local changelog_path="${output_dir}/${CHANGELOG_FILENAME}"
    prepend_to_file "$changelog_path" "$changelog_section"
    log_info "  ✅ ${CHANGELOG_FILENAME} updated: $changelog_path"

    if [ "$environment" = "staging" ]; then
        # --- QA_NOTES.md (staging, with QA exclusions) ---
        local qa_categorized
        qa_categorized=$(categorize_commits "$commits" "qa_notes")
        local qa_section
        qa_section=$(generate_version_section "$version_display" "$date_str" "$qa_categorized")
        local qa_path="${output_dir}/${QA_NOTES_FILENAME}"
        prepend_to_file "$qa_path" "$qa_section"
        log_info "  ✅ ${QA_NOTES_FILENAME} updated: $qa_path"

        # Deliver via webhook if configured
        deliver_webhook "$qa_path"

    elif [ "$environment" = "production" ]; then
        # --- RELEASE_NOTES.md (production, with release exclusions) ---
        local rn_categorized
        rn_categorized=$(categorize_commits "$commits" "release_notes")
        local rn_section
        rn_section=$(generate_version_section "$version_display" "$date_str" "$rn_categorized")
        local rn_path="${output_dir}/${RELEASE_NOTES_FILENAME}"
        prepend_to_file "$rn_path" "$rn_section"
        log_info "  ✅ ${RELEASE_NOTES_FILENAME} updated: $rn_path"
    fi
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    local environment="$1"
    local version="${2:-}"

    # --- Validate arguments ---
    if [ -z "$environment" ]; then
        log_error "Environment required: staging or production"
        log_info "Usage: git trident staging|production changelog <version>"
        exit 1
    fi

    if [ -z "$version" ]; then
        log_error "Version required"
        log_info "Usage: git trident ${environment} changelog <version>"
        exit 1
    fi

    log_info "📋 Git Trident Changelog Generator"
    log_info "=================================="
    log_info "  Environment: $environment"
    log_info "  Version:     $version"
    log_empty ""

    # --- Pre-operation checks ---
    if ! pre_operation_checks "changelog"; then
        exit 1
    fi

    # --- Branch validation ---
    if ! validate_branch "$environment"; then
        exit 1
    fi

    # --- Platform resolution ---
    local platform=""
    if is_platform_specific_mode; then
        platform=$(extract_platform_from_version "$version")
        if [ -z "$platform" ]; then
            log_error "Platform-specific mode enabled but no platform found in version: $version"
            log_info "Expected format: platform-MAJOR.MINOR.PATCH"
            exit 1
        fi
        log_info "  Platform:    $platform"
    fi

    # --- Version display ---
    local version_display
    version_display=$(resolve_version_display "$environment" "$version" "$platform")
    log_info "  Display:     $version_display"

    # --- Find previous tag ---
    local prev_tag
    prev_tag=$(find_previous_env_tag "$environment" "$platform")
    if [ -n "$prev_tag" ]; then
        log_info "  Previous tag: $prev_tag"
    else
        log_info "  Previous tag: <initial> (first release)"
    fi

    # --- Collect commits ---
    log_info "  Collecting commits: ${prev_tag:-<first commit>} → HEAD"
    local commits
    commits=$(collect_commits "$prev_tag" "HEAD")

    # In platform-specific mode, restrict to commits that belong to this platform.
    # Commits tagged [<other-platform>] are excluded; commits with no platform
    # tag (generic commits) are kept alongside [<platform>]-tagged ones.
    if is_platform_specific_mode && [ -n "$platform" ]; then
        local total_before
        total_before=$(echo "$commits" | grep -c . 2>/dev/null || echo 0)
        commits=$(filter_commits_by_platform "$commits" "$platform")
        local total_after
        total_after=$(echo "$commits" | grep -c . 2>/dev/null || echo 0)
        log_info "  Platform filter [$platform]: ${total_before} → ${total_after} commits"
    fi

    if [ -z "$commits" ]; then
        log_warn "  No commits found since ${prev_tag:-initial commit}."
    fi

    # --- Date ---
    local date_str
    date_str=$(date "+%B %-d, %Y")

    # --- Output directory ---
    local output_dir
    output_dir=$(get_output_dir "$platform")

    # --- Write files ---
    write_files "$environment" "$output_dir" "$version_display" "$date_str" "$commits"

    log_empty ""
    log_info "🎉 Done! Review the generated file(s) and commit them before finishing the release."
}

# Auto-execute if not sourced
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
