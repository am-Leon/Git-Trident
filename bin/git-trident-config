#!/bin/bash
# Git Trident Tools — Config management
# Subcommands:
#   init     – interactively scaffold the project config for a new project
#   show     – display active configuration
#   validate – check the configuration without running a workflow operation
#   help    – show this help

# Fail a pipeline when ANY stage fails, not just the last one. Safe on Bash 3.2.
# `set -u` is deliberately NOT used: on 3.2 it makes expanding an empty array
# fatal, and there are 80+ such expansions. See docs/REMEDIATION_PLAN.md A9.
set -o pipefail

# --- Git Trident entry-point preamble (A1a) ---------------------------------
# Resolve this script's REAL location, following symlinks, so the tool works
# when the entry point is symlinked onto PATH (e.g. /usr/local/bin/git-trident)
# and when installed to a custom directory.
#
# Portability notes (macOS / Linux / Windows Git Bash):
#   * plain `readlink`, never `readlink -f` — `-f` is GNU-only and missing on
#     macOS before 12.3; plain readlink is POSIX and present on BSD and MSYS2.
#   * the loop follows symlink CHAINS and relative link targets.
#   * on Windows, `ln -s` normally copies rather than links, so [ -L ] is false
#     and the loop is simply skipped — correct behaviour either way.
GT_SELF="${BASH_SOURCE[0]}"
while [ -L "$GT_SELF" ]; do
    GT_LINK_DIR="$(cd -P "$(dirname "$GT_SELF")" && pwd)"
    GT_SELF="$(readlink "$GT_SELF")"
    case "$GT_SELF" in /*) ;; *) GT_SELF="$GT_LINK_DIR/$GT_SELF" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$GT_SELF")" && pwd)"
# GT_INSTALL_ROOT is part of the shared entry-point contract: every script sets
# it, and git-trident-hooks (discover_install_dir) and git-trident-version
# (passing the install root to the updater) read it. Scripts that do not read it
# still define it so the preamble stays identical everywhere.
# shellcheck disable=SC2034
GT_INSTALL_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"
# ----------------------------------------------------------------------------

# Source common utilities
source "$SCRIPT_DIR/../lib/git-trident-common.sh" --no-init
source "$SCRIPT_DIR/../lib/git-trident-help.sh"

# =============================================================================
# HELPERS
# =============================================================================

_ask() {
    # _ask <prompt> <default>  — prints the answer
    local prompt="$1"
    local default="$2"
    local answer
    if [[ -n "$default" ]]; then
        read -rp "$(echo -e "${BLUE}?${NC} $prompt [${default}]: ")" answer
        echo "${answer:-$default}"
    else
        read -rp "$(echo -e "${BLUE}?${NC} $prompt: ")" answer
        echo "$answer"
    fi
}

_ask_bool() {
    # _ask_bool <prompt> <default true|false>
    local prompt="$1"
    local default="${2:-false}"
    local hint
    [[ "$default" == "true" ]] && hint="Y/n" || hint="y/N"
    local answer
    read -rp "$(echo -e "${BLUE}?${NC} $prompt [$hint]: ")" answer

    # An empty answer means "accept the default" — return it verbatim.
    #
    # This previously did:  answer="${answer:-$default}"
    # which substituted the literal string "true", and "true" does not match
    # ^[Yy] — so pressing Enter on a prompt displaying [Y/n] silently wrote
    # false. An all-defaults `config init` produced HOOK_COMMIT_MSG_ENABLED=false
    # and REQUIRE_CAPITAL_START=false.
    if [[ -z "$answer" ]]; then
        echo "$default"
        return 0
    fi

    [[ "$answer" =~ ^[Yy] ]] && echo "true" || echo "false"
}

# =============================================================================
# INIT COMMAND
# =============================================================================

cmd_init() {
    # This command runs with --no-init, so the repository context has not been
    # resolved yet. Resolve it here so `config init` from a subdirectory writes
    # the config to the repository ROOT, where load_project_config looks for it.
    if ! gt_resolve_repo_context; then
        log_error "❌ Not inside a Git repository."
        log_error "   Run 'git trident config init' from within your project."
        exit 1
    fi

    local OUTPUT_FILE; OUTPUT_FILE="$(gt_repo_path "$CONFIG_FILE_NAME")"

    log_info "🛠  GIT TRIDENT — Project Config Init"
    log_info "========================================"
    log_empty ""

    # Safety: don't overwrite unless confirmed
    if [[ -f "$OUTPUT_FILE" ]]; then
        log_warn "A project config already exists: $OUTPUT_FILE"
        if ! confirm_action "Overwrite it?"; then
            log_info "Aborted. Existing config preserved."
            exit 0
        fi
        # Back it up first
        cp "$OUTPUT_FILE" "${OUTPUT_FILE}.bak.$(date +%Y%m%d_%H%M%S)"
        log_info "Backed up existing config."
    fi

    log_info "Answer the prompts below (press Enter to accept the default)."
    log_empty ""

    # ── Branch names ──────────────────────────────────────────────────────────
    log_info "── Branches ──────────────────────────────────"
    local prod_branch;   prod_branch=$(_ask   "Production branch name"    "production")
    local staging_branch; staging_branch=$(_ask "Staging branch name"      "staging")
    local develop_branch; develop_branch=$(_ask "Develop branch name"      "develop")

    # ── Remote ───────────────────────────────────────────────────────────────
    log_empty ""
    log_info "── Remote ────────────────────────────────────"
    local remote; remote=$(_ask "Remote name" "origin")

    # ── Tag prefixes ──────────────────────────────────────────────────────────
    log_empty ""
    log_info "── Tag prefixes ──────────────────────────────"
    local stag_prefix; stag_prefix=$(_ask "Staging tag prefix"    "staging/")
    local prod_prefix; prod_prefix=$(_ask "Production tag prefix" "production/")
    local rc_suffix;   rc_suffix=$(_ask   "RC suffix"             "-rc-")

    # ── Multi-platform ────────────────────────────────────────────────────────
    log_empty ""
    log_info "── Multi-platform ────────────────────────────"
    local platform_mode; platform_mode=$(_ask_bool "Enable platform-specific tags (KMP/multi-platform)?" "false")

    local platforms="" common_platforms="" independent_platforms=""
    if [[ "$platform_mode" == "true" ]]; then
        platforms=$(_ask        "All platforms (space-separated, e.g. shared android ios)" "")
        common_platforms=$(_ask "Common platforms (e.g. shared)"                           "")
        independent_platforms=$(_ask "Independent platforms (e.g. android ios)"           "")
    fi

    # ── Conflict strategy ─────────────────────────────────────────────────────
    log_empty ""
    log_info "── Workflow ──────────────────────────────────"
    log_info "   Conflict strategy options: interactive | prefer-ours | prefer-theirs"
    local conflict; conflict=$(_ask "Conflict strategy" "interactive")

    # ── Branch prefixes ───────────────────────────────────────────────────────
    log_empty ""
    log_info "── Branch prefixes (internal) ────────────────"
    local rel_stag; rel_stag=$(_ask "Staging release prefix"    "release/stg/")
    local rel_prod; rel_prod=$(_ask "Production release prefix"  "release/prod/")
    local hf_stag;  hf_stag=$(_ask  "Staging hotfix prefix"     "hotfix/stg/")
    local hf_prod;  hf_prod=$(_ask  "Production hotfix prefix"  "hotfix/prod/")

    # ── Changelog ─────────────────────────────────────────────────────────────
    log_empty ""
    log_info "── Changelog ─────────────────────────────────"
    local qa_excl;   qa_excl=$(_ask   "QA excluded prefixes (pipe-separated)"      "")
    local rel_excl;  rel_excl=$(_ask  "Release excluded prefixes (pipe-separated)" "wip|cmd")

    # ── Hooks ─────────────────────────────────────────────────────────────────
    log_empty ""
    log_info "── Commit-message hook rules ──────────────────"
    local hook_commit; hook_commit=$(_ask_bool "Enable commit-msg hook?" "true")
    local prefixes;    prefixes=$(_ask    "Commit prefixes (pipe-separated)" "wip|fix|feat|enhance|cmd")
    local prefix_desc; prefix_desc=$(_ask "Prefix descriptions (pipe-separated)" \
                                          "Work In Progress|Bug Fixes|New Features|Enhancements|Commands")
    local cap_start;   cap_start=$(_ask_bool "Require capital start in commit description?" "true")
    local min_words;   min_words=$(_ask   "Minimum word count in description" "3")
    local cmd_words;   cmd_words=$(_ask   "Minimum word count for cmd: prefix"  "2")

    # ── Write the file ────────────────────────────────────────────────────────
    log_empty ""
    log_info "Writing $OUTPUT_FILE …"

    cat > "$OUTPUT_FILE" <<EOF
# =============================================================================
# Git Trident Tools — Project Configuration
# Generated by: git trident config init  ($(date '+%Y-%m-%d %H:%M'))
# =============================================================================
# IMPORTANT: Commit this file to git — teammates get your settings automatically.
# Global/machine settings (AUTO_PUSH, DEBUG, HOOKS_ENABLED…) live in:
#   ~/.git-trident-config   (never committed)
# =============================================================================

# =============================================================================
# REQUIRED — BRANCH NAMES
# =============================================================================
PRODUCTION_BRANCH="${prod_branch}"
STAGING_BRANCH="${staging_branch}"
DEVELOP_BRANCH="${develop_branch}"

# =============================================================================
# REQUIRED — TAG PREFIXES
# =============================================================================
STAGING_TAG_PREFIX="${stag_prefix}"
PRODUCTION_TAG_PREFIX="${prod_prefix}"
STAGING_TAG_SUFFIX="${rc_suffix}"

# =============================================================================
# REQUIRED — REMOTE
# =============================================================================
REMOTE="${remote}"

# =============================================================================
# BRANCH PREFIXES
# =============================================================================
RELEASE_STAGING_PREFIX="${rel_stag}"
RELEASE_PRODUCTION_PREFIX="${rel_prod}"
HOTFIX_STAGING_PREFIX="${hf_stag}"
HOTFIX_PRODUCTION_PREFIX="${hf_prod}"

# =============================================================================
# WORKFLOW
# =============================================================================
CONFLICT_STRATEGY="${conflict}"

# =============================================================================
# MULTI-PLATFORM
# =============================================================================
PLATFORM_SPECIFIC_TAGS=${platform_mode}
PLATFORMS="${platforms}"
COMMON_PLATFORMS="${common_platforms}"
INDEPENDENT_PLATFORMS="${independent_platforms}"

# =============================================================================
# COMMIT-MESSAGE HOOK RULES
# =============================================================================
HOOK_COMMIT_MSG_ENABLED=${hook_commit}
COMMIT_PREFIXES="${prefixes}"
COMMIT_PREFIX_DESCRIPTIONS="${prefix_desc}"
COMMIT_PLATFORM_PREFIX_FORMAT="[platform]"
REQUIRE_CAPITAL_START=${cap_start}
MIN_WORD_COUNT=${min_words}
CMD_MIN_WORD_COUNT=${cmd_words}

# =============================================================================
# CHANGELOG & RELEASE NOTES
# =============================================================================
CHANGELOG_QA_EXCLUDED_PREFIXES="${qa_excl}"
CHANGELOG_RELEASE_EXCLUDED_PREFIXES="${rel_excl}"
EOF

    log_empty ""
    log_info "✅ Created: $OUTPUT_FILE"
    log_empty ""
    log_info "Next steps:"
    log_info "  1. Review and tweak the file if needed"
    log_info "  2. git add git-trident-config"
    log_info "  3. git commit -m \"cmd: Add git-trident project config\""

    # Warn if any global-only keys accidentally ended up in the file
    _warn_global_only_keys_in_project_config "$OUTPUT_FILE"
}

# =============================================================================
# VALIDATE COMMAND
# =============================================================================

# Check configuration WITHOUT running a workflow operation.
#
# Previously the only way to learn whether a config was usable was to start a
# real release and watch it fail partway through. This answers the question
# directly and is safe to run in CI.
cmd_validate() {
    log_info "🔍 Validating Git Trident configuration"
    log_info "========================================"
    log_empty ""

    local problems=0 warnings=0

    if ! gt_resolve_repo_context; then
        log_error "❌ Not inside a Git repository."
        return 1
    fi
    log_info "Repository : $GT_REPO_ROOT"

    local global_config="$HOME/$GLOBAL_CONFIG_FILE_NAME"
    local project_config; project_config="$(gt_repo_path "$CONFIG_FILE_NAME")"
    [ -f "$project_config" ] || project_config="$(gt_repo_path ".$CONFIG_FILE_NAME")"

    if [ -f "$global_config" ]; then
        log_info "Global     : $global_config"
    else
        log_warn "Global     : not found ($global_config)"
        warnings=$((warnings + 1))
    fi

    if [ -f "$project_config" ]; then
        log_info "Project    : $project_config"
    else
        log_error "Project    : not found"
        log_info  "             Run: git trident config init"
        return 1
    fi
    log_empty ""

    # Load through the real loader so validation matches runtime exactly.
    if ! load_project_config; then
        log_error "❌ Configuration failed to load."
        return 1
    fi

    log_info "Required keys:"
    local var
    for var in "${REQUIRED_CONFIG_VARS[@]}"; do
        if [ -n "${!var:-}" ]; then
            log_info "  ✅ $var = ${!var}"
        else
            log_error "  ❌ $var is not set"
            problems=$((problems + 1))
        fi
    done
    log_empty ""

    log_info "Branches:"
    local b
    for var in PRODUCTION_BRANCH STAGING_BRANCH DEVELOP_BRANCH; do
        b="${!var:-}"
        [ -z "$b" ] && continue
        if git show-ref --verify --quiet "refs/heads/$b"; then
            log_info "  ✅ $b (local)"
        elif git ls-remote --heads "$REMOTE" "$b" 2>/dev/null | grep -q .; then
            log_warn "  ⚠️  $b exists on $REMOTE but not locally"
            warnings=$((warnings + 1))
        else
            log_error "  ❌ $b does not exist"
            problems=$((problems + 1))
        fi
    done
    log_empty ""

    log_info "Remote:"
    if git remote get-url "$REMOTE" >/dev/null 2>&1; then
        log_info "  ✅ $REMOTE -> $(git remote get-url "$REMOTE")"
    else
        log_error "  ❌ remote '$REMOTE' is not configured"
        problems=$((problems + 1))
    fi
    log_empty ""

    if is_platform_specific_mode; then
        log_info "Platforms:"
        log_info "  All         : ${PLATFORMS:-<unset>}"
        log_info "  Common      : ${COMMON_PLATFORMS:-<unset>}"
        log_info "  Independent : ${INDEPENDENT_PLATFORMS:-<unset>}"
        local errs=()
        validate_platform_classification "errs"
        if [ "${#errs[@]}" -eq 0 ]; then
            log_info "  ✅ Classification is consistent"
        else
            local e
            for e in ${errs[@]+"${errs[@]}"}; do
                log_error "  ❌ $e"
                problems=$((problems + 1))
            done
        fi
        log_empty ""
    fi

    local found_schema="${CONFIG_SCHEMA_VERSION:-}"
    if [ -z "$found_schema" ]; then
        log_warn "Schema: no CONFIG_SCHEMA_VERSION (assuming 1)"
        log_info "        Add: CONFIG_SCHEMA_VERSION=\"$CONFIG_SCHEMA_CURRENT\""
        warnings=$((warnings + 1))
    elif [ "$found_schema" != "$CONFIG_SCHEMA_CURRENT" ]; then
        log_warn "Schema: config is version $found_schema; current is $CONFIG_SCHEMA_CURRENT"
        warnings=$((warnings + 1))
    else
        log_info "Schema: version $found_schema (current)"
    fi
    log_empty ""

    log_info "========================================"
    if [ "$problems" -gt 0 ]; then
        log_error "❌ $problems problem(s), $warnings warning(s)"
        return 1
    elif [ "$warnings" -gt 0 ]; then
        log_warn "⚠️  Valid, with $warnings warning(s)"
        return 0
    fi
    log_info "✅ Configuration is valid"
    return 0
}

# =============================================================================
# SHOW COMMAND (alias for 'git trident version config')
# =============================================================================

cmd_show() {
    execute_script() {
        local script_path="$SCRIPT_DIR/$1"
        shift
        if [[ -f "$script_path" ]]; then
            exec "$script_path" "$@"
        fi
    }
    exec "$SCRIPT_DIR/git-trident-version" "config"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    local subcommand="${1:-}"
    shift || true

    case "$subcommand" in
        "init")
            cmd_init "$@"
            ;;
        "validate"|"check")
            cmd_validate
            ;;
        "show"|"")
            cmd_show "$@"
            ;;
        "--help"|"-h"|"help")
            show_config_help
            ;;
        *)
            log_error "Unknown config subcommand: $subcommand"
            log_error "Usage: git trident config [init|show|validate|help]"
            exit 1
            ;;
    esac
}

main "$@"
