#!/bin/bash
# Cleanup/Pruning tool for deprecated staging tags and stale local branches.
#
# Subcommands:
#   prune [tags]          – delete deprecated staging RC tags (local + remote).
#                           'tags' is the only valid target for prune.
#   sync [tags|branches]  – sync local state from remote.
#                           No target (or 'tags'): prune stale local tags.
#                           'branches': remove local branches whose remote is gone.
#                           Omitting target runs BOTH tags and branches.

# Fail a pipeline when ANY stage fails, not just the last one. Safe on Bash 3.2.
# `set -u` is deliberately NOT used: on 3.2 it makes expanding an empty array
# fatal, and there are 80+ such expansions. See docs/REMEDIATION_PLAN.md A9.
set -o pipefail

# --- Git Trident entry-point preamble (A1a) ---------------------------------
# Resolve this script's REAL location, following symlinks, so the tool works
# when the entry point is symlinked onto PATH (e.g. /usr/local/bin/git-trident)
# and when installed to a custom directory.
#
# Portability notes (macOS / Linux / Windows Git Bash):
#   * plain `readlink`, never `readlink -f` — `-f` is GNU-only and missing on
#     macOS before 12.3; plain readlink is POSIX and present on BSD and MSYS2.
#   * the loop follows symlink CHAINS and relative link targets.
#   * on Windows, `ln -s` normally copies rather than links, so [ -L ] is false
#     and the loop is simply skipped — correct behaviour either way.
GT_SELF="${BASH_SOURCE[0]}"
while [ -L "$GT_SELF" ]; do
    GT_LINK_DIR="$(cd -P "$(dirname "$GT_SELF")" && pwd)"
    GT_SELF="$(readlink "$GT_SELF")"
    case "$GT_SELF" in /*) ;; *) GT_SELF="$GT_LINK_DIR/$GT_SELF" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$GT_SELF")" && pwd)"
# GT_INSTALL_ROOT is part of the shared entry-point contract: every script sets
# it, and git-trident-hooks (discover_install_dir) and git-trident-version
# (passing the install root to the updater) read it. Scripts that do not read it
# still define it so the preamble stays identical everywhere.
# shellcheck disable=SC2034
GT_INSTALL_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"
# ----------------------------------------------------------------------------

# Source common utilities
source "$SCRIPT_DIR/../lib/git-trident-common.sh"
source "$SCRIPT_DIR/../lib/git-trident-version-utils.sh"

# =============================================================================
# LOGIC
# =============================================================================

prune_staging_tags() {
    log_info "🔍 Scanning for deprecated staging tags..."
    
    # 1. Get all production tags
    local prod_tags=$(git tag -l "${PRODUCTION_TAG_PREFIX}*")
    local tags_to_delete=()
    local versions_cleaned=0

    # 2. Find corresponding staging tags
    for prod_tag in $prod_tags; do
        # Extract version from prod tag (e.g. "v1.0.0" -> "1.0.0")
        local version=${prod_tag#"$PRODUCTION_TAG_PREFIX"}
        
        # Look for staging tags for this version (e.g. "staging-1.0.0-rc*")
        local staging_pattern="${STAGING_TAG_PREFIX}${version}$(get_rc_suffix)*"
        local staging_matches=$(git tag -l "$staging_pattern")
        
        if [ -n "$staging_matches" ]; then
            for tag in $staging_matches; do
                tags_to_delete+=("$tag")
            done
            versions_cleaned=$((versions_cleaned + 1))
        fi
    done

    # 3. Find unpublished staging tags that are older than the latest production version
    local all_staging_tags=$(git tag -l "${STAGING_TAG_PREFIX}*")
    for staging_tag in $all_staging_tags; do
        # Skip if already marked for deletion
        local already_added=false
        for existing in "${tags_to_delete[@]}"; do
            if [ "$existing" = "$staging_tag" ]; then
                already_added=true
                break
            fi
        done
        
        if [ "$already_added" = false ]; then
            local base_version=$(extract_base_version_from_tag "$staging_tag" "$STAGING_TAG_PREFIX")
            local platform=$(extract_platform_from_version "$base_version")
            
            local latest_prod
            if [ -n "$platform" ]; then
                latest_prod=$(get_latest_production_tag_for_platform "$platform")
            else
                latest_prod=$(get_latest_production_tag)
            fi
            
            if [ -n "$latest_prod" ]; then
                # Check if latest_prod is logically greater than the base_version
                if is_version_greater "$latest_prod" "$base_version"; then
                    tags_to_delete+=("$staging_tag")
                fi
            fi
        fi
    done

    # 4. Report findings
    local count=${#tags_to_delete[@]}
    if [ "$count" -eq 0 ]; then
        log_info "✅ No deprecated staging tags found."
        log_info "   (All staging tags refer to versions not yet in production and are not older than production)"
        return 0
    fi

    log_info "Found $count deprecated staging tags."
    log_info "These tags correspond to versions that are already released or are older than the latest production release."
    echo ""
    
    # Show first 10
    local shown=0
    for tag in "${tags_to_delete[@]}"; do
        echo "   • $tag"
        shown=$((shown + 1))
        if [ "$shown" -ge 10 ]; then
            echo "   ... and $((count - 10)) more"
            break
        fi
    done
    echo ""

    # 4. Confirm Deletion
    if ! confirm_action "Delete these $count tags from LOCAL and REMOTE ($REMOTE)?"; then
        log_info "Operation cancelled."
        return 0
    fi

    log_info "🗑️  Deleting tags..."

    # --- Local deletion -----------------------------------------------------
    # Delete one at a time and count real successes. The previous version piped
    # everything through `xargs git tag -d >/dev/null 2>&1` and then logged
    # "✓ Deleted $count local tags" unconditionally, so failures were invisible.
    local deleted_local=0 failed_local=0 tag
    for tag in ${tags_to_delete[@]+"${tags_to_delete[@]}"}; do
        if git tag -d "$tag" >/dev/null 2>&1; then
            deleted_local=$((deleted_local + 1))
        else
            failed_local=$((failed_local + 1))
            log_warn "   ✗ Could not delete local tag: $tag"
        fi
    done

    # --- Remote deletion ----------------------------------------------------
    # Only submit tags that actually exist on the remote. `git push --delete`
    # fails the WHOLE batch if any single ref is missing, so one stale entry
    # used to silently abort deletion of the other nineteen.
    log_info "⏳ Checking which tags exist on $REMOTE..."
    local remote_tag_list
    remote_tag_list=$(git ls-remote --tags "$REMOTE" 2>/dev/null | sed 's|.*refs/tags/||' | sed 's|\^{}$||' | sort -u)

    if [ -z "$remote_tag_list" ]; then
        log_warn "Could not read tags from $REMOTE — skipping remote deletion."
        log_info "📝 Summary: $deleted_local local deleted, $failed_local failed, remote skipped"
        return 1
    fi

    local to_delete_remote=() skipped_remote=0
    for tag in ${tags_to_delete[@]+"${tags_to_delete[@]}"}; do
        if printf '%s\n' "$remote_tag_list" | grep -qxF "$tag"; then
            to_delete_remote+=("$tag")
        else
            skipped_remote=$((skipped_remote + 1))
        fi
    done

    local deleted_remote=0 failed_remote=0
    if [ "${#to_delete_remote[@]}" -gt 0 ]; then
        log_info "⏳ Deleting ${#to_delete_remote[@]} remote tag(s)..."
        local batch=()
        _flush_batch() {
            [ "${#batch[@]}" -eq 0 ] && return 0
            if git push "$REMOTE" --delete ${batch[@]+"${batch[@]}"} >/dev/null 2>&1; then
                deleted_remote=$((deleted_remote + ${#batch[@]}))
            else
                # Fall back to one-by-one so a single bad ref cannot hide the rest.
                local t
                for t in ${batch[@]+"${batch[@]}"}; do
                    if git push "$REMOTE" --delete "$t" >/dev/null 2>&1; then
                        deleted_remote=$((deleted_remote + 1))
                    else
                        failed_remote=$((failed_remote + 1))
                        log_warn "   ✗ Could not delete remote tag: $t"
                    fi
                done
            fi
            batch=()
        }
        for tag in "${to_delete_remote[@]}"; do
            batch+=("$tag")
            if [ "${#batch[@]}" -ge 20 ]; then _flush_batch; fi
        done
        _flush_batch
        unset -f _flush_batch
    fi

    # --- Honest summary -----------------------------------------------------
    log_empty
    log_info "📝 Cleanup summary:"
    log_info "   • Local:  $deleted_local deleted, $failed_local failed"
    log_info "   • Remote: $deleted_remote deleted, $failed_remote failed, $skipped_remote not present"

    if [ "$failed_local" -gt 0 ] || [ "$failed_remote" -gt 0 ]; then
        log_warn "⚠️  Cleanup completed with errors."
        return 1
    fi

    log_info "🎉 Cleanup complete!"
    log_warn "📢 Tell your teammates to run: 'git trident cleanup sync'"
    return 0
}

sync_local_tags() {
    log_info "🔄 SYNCING TAGS FROM REMOTE '$REMOTE'"
    log_info "This will prune local tags that no longer exist on the remote."
    log_empty
    
    # Check remote connectivity first
    if ! git ls-remote "$REMOTE" > /dev/null 2>&1; then
        log_error "Cannot reach remote '$REMOTE'"
        exit 1
    fi

    # Run fetch with prune-tags
    # --prune-tags: remove local tags that don't exist on remote
    # --force: force update tags
    if git fetch --prune --prune-tags --force "$REMOTE"; then
        log_info "✅ Local tags synchronized."
        log_info "   - Deleted local tags that were removed from remote."
        log_info "   - Updated existing tags."
    else
        log_error "Failed to sync tags."
        exit 1
    fi
}

sync_local_branches() {
    log_info "🌿 SYNCING LOCAL BRANCHES FROM REMOTE '$REMOTE'"
    log_info "This will remove any local tracking branches that no longer exist on the remote."
    log_empty

    # Check remote connectivity first
    if ! git ls-remote "$REMOTE" > /dev/null 2>&1; then
        log_error "Cannot reach remote '$REMOTE'"
        exit 1
    fi

    # Fetch + prune remote-tracking refs so git knows which remotes are gone
    log_info "⏳ Fetching remote to refresh tracking info..."
    if ! git fetch --prune "$REMOTE" > /dev/null 2>&1; then
        log_error "Failed to fetch from remote '$REMOTE'."
        exit 1
    fi

    # Collect protected branches (never delete these)
    local protected=("$PRODUCTION_BRANCH" "$STAGING_BRANCH" "$DEVELOP_BRANCH")
    local current_branch
    current_branch=$(git branch --show-current 2>/dev/null || git symbolic-ref --short HEAD 2>/dev/null)

    # Find local branches whose upstream tracking ref is gone
    local -a stale_branches=()
    while IFS= read -r line; do
        # 'git branch -vv' marks stale branches as [remote/branch: gone]
        # Extract branch name from lines like: "  feature/foo abc1234 [origin/feature/foo: gone] commit msg"
        local branch_name
        branch_name=$(echo "$line" | awk '{print $1}' | sed 's/^\* //')

        # Skip empty, HEAD, or current branch
        [[ -z "$branch_name" || "$branch_name" == "HEAD" ]] && continue

        # Skip protected branches
        local is_protected=false
        for p in "${protected[@]}"; do
            if [[ "$branch_name" == "$p" ]]; then
                is_protected=true
                break
            fi
        done
        [[ "$is_protected" == "true" ]] && continue

        # Skip the currently checked-out branch
        [[ "$branch_name" == "$current_branch" ]] && continue

        stale_branches+=("$branch_name")
    done < <(git branch -vv | grep ': gone]')

    if [[ ${#stale_branches[@]} -eq 0 ]]; then
        log_info "✅ No stale local branches found. All local branches have a live remote counterpart."
        return 0
    fi

    log_info "Found ${#stale_branches[@]} local branch(es) whose remote tracking ref is gone:"
    echo ""
    for b in "${stale_branches[@]}"; do
        echo "   • $b"
    done
    echo ""

    if confirm_action "Delete these ${#stale_branches[@]} stale local branch(es)?"; then
        local deleted=0
        local failed=0
        for b in "${stale_branches[@]}"; do
            if git branch -d "$b" > /dev/null 2>&1; then
                log_info "   ✓ Deleted: $b"
                deleted=$((deleted + 1))
            else
                # Try force-delete if not fully merged
                if confirm_action "   Branch '$b' is not fully merged. Force-delete it?"; then
                    if git branch -D "$b" > /dev/null 2>&1; then
                        log_info "   ✓ Force-deleted: $b"
                        deleted=$((deleted + 1))
                    else
                        log_warn "   ✗ Failed to delete: $b"
                        failed=$((failed + 1))
                    fi
                else
                    log_info "   - Skipped: $b"
                    failed=$((failed + 1))
                fi
            fi
        done
        echo ""
        log_info "🎉 Branch sync complete! Deleted: $deleted  Skipped/failed: $failed"
    else
        log_info "Operation cancelled."
    fi
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    local subcommand="${1:-}"
    shift || true
    local target="${1:-}"

    case "$subcommand" in
        "prune"|"start")
            # target must be empty or 'tags' (the only meaningful prune target)
            if [[ -n "$target" && "$target" != "tags" ]]; then
                log_error "'prune' only supports the 'tags' target (or no target)."
                log_error "Usage: git trident cleanup prune [tags]"
                exit 1
            fi
            prune_staging_tags
            ;;
        "sync")
            case "${target:-both}" in
                "tags")
                    sync_local_tags
                    ;;
                "branches")
                    sync_local_branches
                    ;;
                "both"|"")
                    log_info "🔄 FULL SYNC: tags + branches"
                    log_empty
                    sync_local_tags
                    echo ""
                    sync_local_branches
                    ;;
                *)
                    log_error "Unknown target '$target'. Use: tags | branches  (or omit for both)"
                    exit 1
                    ;;
            esac
            ;;
        "--help"|"-h"|"help")
            if [ -f "$SCRIPT_DIR/../lib/git-trident-help.sh" ]; then
                source "$SCRIPT_DIR/../lib/git-trident-help.sh"
                show_cleanup_help
            else
                log_error "Help module not found."
            fi
            ;;
        "")
            log_error "Usage: git trident cleanup <subcommand> [target]"
            log_error "  prune [tags]          – delete deprecated staging RC tags"
            log_error "  sync [tags|branches]  – sync tags/branches from remote"
            log_error ""
            log_error "Run 'git trident cleanup --help' for details."
            exit 1
            ;;
        *)
            log_error "Unknown subcommand: $subcommand"
            log_error "Usage: git trident cleanup prune [tags] | sync [tags|branches]"
            exit 1
            ;;
    esac
}

main "$@"
