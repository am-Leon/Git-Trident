# Default ignored files
/.idea/
.DS_Store

# =============================================================================
# Git Trident — config file rules
# =============================================================================
# git-trident-config       → COMMIT THIS (project settings, shared with team)
# .git-trident-config      → optional hidden variant; gitignore it if you
#                               prefer not to commit it (teammates fall back to global)
# ~/.git-trident-config    → global/machine config; NEVER in git
# =============================================================================

# Uncomment to gitignore the hidden project config variant:
# .git-trident-config

# Build artifacts (generated by build.sh, attached to releases via CI)
dist/

# Verification reports (generated by: git trident verify-sync --report)
.git-trident-reports/

# Test sandbox (tests/test_config_cleanup_hooks.sh)
tests/sandbox_test/
tests/sandbox_test_remote.git/
tests/sandbox_subprocess/
tests/sandbox_subprocess_remote.git/
